<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ccc_bg">

    <com.smartazerigas.ccc.ui.LetterboxLayout
        android:id="@+id/letterbox"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.smartazerigas.ccc.ui.SwipeFrameLayout
            android:id="@+id/swipeHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <android.webkit.WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ccc_bg"
                android:overScrollMode="never" />
        </com.smartazerigas.ccc.ui.SwipeFrameLayout>
    </com.smartazerigas.ccc.ui.LetterboxLayout>

    <TextView
        android:id="@+id/pageBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/ccc_muted"
        android:textSize="13sp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/menu_content_description"
        android:src="@drawable/ic_menu_dots"
        app:backgroundTint="@color/ccc_fab_fill"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="normal"
        app:maxImageSize="22dp"
        app:tint="@color/ccc_cyan" />
</FrameLayout>
