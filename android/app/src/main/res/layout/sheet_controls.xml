<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ccc_panel"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="28dp"
    android:paddingTop="10dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/controls_title"
        android:textColor="@color/ccc_cyan"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheetPageLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ccc_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/dashboard"
        android:textColor="@color/ccc_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOperations"
            style="@style/Widget.SmartAzerigasCCC.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/operations" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSocnoc"
            style="@style/Widget.SmartAzerigasCCC.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/socnoc" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFilters"
        style="@style/Widget.SmartAzerigasCCC.ActionButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/filters"
        app:icon="@android:drawable/ic_menu_today"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/ccc_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewAll"
        style="@style/Widget.SmartAzerigasCCC.ActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/view_all"
        app:icon="@android:drawable/ic_menu_zoom"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/ccc_cyan" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToPage"
        style="@style/Widget.SmartAzerigasCCC.ActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/back_to_page"
        android:visibility="gone" />
</LinearLayout>
