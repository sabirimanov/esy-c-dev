<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartAzerigasCCC" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ccc_cyan</item>
        <item name="colorPrimaryVariant">@color/ccc_cyan_dim</item>
        <item name="colorSecondary">@color/ccc_cyan</item>
        <item name="colorOnPrimary">@color/ccc_bg</item>
        <item name="colorSurface">@color/ccc_panel</item>
        <item name="colorOnSurface">@color/ccc_text</item>
        <item name="android:statusBarColor">@color/ccc_bg</item>
        <item name="android:navigationBarColor">@color/ccc_bg</item>
        <item name="android:windowBackground">@color/ccc_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="bottomSheetDialogTheme">@style/Theme.SmartAzerigasCCC.BottomSheet</item>
    </style>

    <style name="Theme.SmartAzerigasCCC.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SmartAzerigasCCC.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/ccc_panel</item>
        <item name="behavior_skipCollapsed">true</item>
        <item name="behavior_fitToContents">true</item>
        <item name="behavior_peekHeight">0dp</item>
        <item name="behavior_expandedOffset">0dp</item>
    </style>

    <style name="Widget.SmartAzerigasCCC.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/ccc_panel</item>
        <item name="shapeAppearance">@style/Shape.SmartAzerigasCCC.Sheet</item>
    </style>

    <style name="Shape.SmartAzerigasCCC.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="Widget.SmartAzerigasCCC.ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ccc_text</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/ccc_panel_elevated</item>
        <item name="cornerRadius">30dp</item>
        <item name="strokeColor">@color/ccc_cyan</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.SmartAzerigasCCC.ActionButton.Primary" parent="Widget.SmartAzerigasCCC.ActionButton">
        <item name="backgroundTint">@color/ccc_cyan_dim</item>
        <item name="android:textColor">@color/ccc_text</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>
